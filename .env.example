# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE_PROJECT_ID / FIRESTORE_DATABASE_ID:
# Firestore operacional usado pelo client e pelo backend Admin SDK.
FIREBASE_PROJECT_ID=gen-lang-client-0529830528
FIRESTORE_DATABASE_ID=ai-studio-534c2e7e-8664-4b76-95e3-faf31fc1628b

# DATABASE_URL / CLOUD_SQL_DATABASE_URL:
# PostgreSQL/Cloud SQL para BI. Opcional ate o Cloud SQL/SQL Connect existir.
DATABASE_URL=
CLOUD_SQL_DATABASE_URL=
CLOUD_SQL_CONNECTION_NAME=gen-lang-client-0529830528:us-east1:gen-lang-client-0529830528-instance
CLOUD_SQL_INSTANCE=gen-lang-client-0529830528-instance
CLOUD_SQL_DATABASE=gen-lang-client-0529830528-database
CLOUD_SQL_REGION=us-east1
CLOUD_SQL_USER=
CLOUD_SQL_PASSWORD=
CLOUD_SQL_HOST=
CLOUD_SQL_PORT=5432
FIREBASE_DATACONNECT_SERVICE_ID=gen-lang-client-0529830528-service

# MERCADOPAGO_ACCESS_TOKEN: Token de Acesso da sua conta do Mercado Pago
# Coloque um token de TESTE ou PRODUÇÃO do painel do desenvolvedor Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=

# MERCADOPAGO_WEBHOOK_SECRET:
# Chave secreta gerada no painel do Mercado Pago em Suas integracoes > Webhooks.
# Em producao os webhooks falham fechado sem esta chave.
MERCADOPAGO_WEBHOOK_SECRET=

# SCHOOL_IDE_MONTHLY_PRICE:
# Preco server-side usado pela Function legada de assinatura quando um plano
# do Firestore nao for informado. Preferir planos cadastrados no backend.
SCHOOL_IDE_MONTHLY_PRICE=

# WHATSAPP_API_TOKEN: Token do seu provedor de WhatsApp (Twilio/Evolution/Z-API)
WHATSAPP_API_TOKEN=
