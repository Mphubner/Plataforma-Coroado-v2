                       incoming().tenantId == currentUser().data.tenantId &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(appointmentId) && isValidPastoralAppointment(incoming()) &&
                       incoming().tenantId == existing().tenantId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       (isAdmin() || hasAnyRole(['seniorPastor', 'networkPastor', 'auxPastor']));
      allow delete: if isAdmin();
    }

    match /social_professionals/{professionalId} {
      allow get, list: if resource.data.isPublic == true || isAdmin() || hasAnyRole(['seniorPastor', 'networkPastor', 'auxPastor']);
      allow create: if isSignedIn() && isValidId(professionalId) && isValidSocialProfessional(incoming()) &&
                       incoming().tenantId == currentUser().data.tenantId &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time &&
                       (isAdmin() || hasAnyRole(['seniorPastor', 'networkPastor', 'auxPastor']));
      allow update: if isSignedIn() && isValidId(professionalId) && isValidSocialProfessional(incoming()) &&
                       incoming().tenantId == existing().tenantId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       (isAdmin() || hasAnyRole(['seniorPastor', 'networkPastor', 'auxPastor']));
      allow delete: if isAdmin();
    }

    match /social_appointments/{appointmentId} {
      allow get, list: if isSignedIn() && (isAdmin() || hasAnyRole(['seniorPastor', 'networkPastor', 'auxPastor']) || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(appointmentId) && isValidSocialAppointment(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       incoming().tenantId == currentUser().data.tenantId &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(appointmentId) && isValidSocialAppointment(incoming()) &&
                       incoming().tenantId == existing().tenantId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       (isAdmin() || hasAnyRole(['seniorPastor', 'networkPastor', 'auxPastor']));
      allow delete: if isAdmin();
    }

    match /units/{unitId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(unitId) && isValidUnit(incoming()) &&
                       incoming().tenantId == currentUser().data.tenantId &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time &&
                       isAdmin();
      allow update: if isSignedIn() && isValidId(unitId) && isValidUnit(incoming()) &&
                       incoming().tenantId == existing().tenantId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       isAdmin();
      allow delete: if isAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow get, list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create, update: if isAdmin() && isValidSubscription(request.resource.data);
      allow delete: if isAdmin();
    }

    match /learning_access/{accessId} {
      allow get, list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /members/{memberId} {
      allow get, list: if isSignedIn() && sameTenant(resource.data.tenantId);
      allow create, update, delete: if isAdmin();
    }

    match /coupons/{couponId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isAdmin() && isValidCoupon(incoming());
    }

    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn() && isAdmin() && isValidProduct(incoming());
    }

  }
}
