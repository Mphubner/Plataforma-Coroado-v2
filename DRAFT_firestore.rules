rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    // We treat users with 'admin' in their array as admins, but they can't self-assign this.
    function isAdmin() { 
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             'admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles; 
    }
    
    // Entities Validations
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'name', 'roles', 'isApproved', 'tenantId', 'createdAt', 'updatedAt']) &&
             data.email is string && data.email.size() <= 100 &&
             data.name is string && data.name.size() <= 100 &&
             data.roles is list && data.roles.size() <= 10 &&
             data.isApproved is bool &&
             data.tenantId is string && data.tenantId.size() <= 128 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidTask(data) {
      return data.keys().hasAll(['title', 'tag', 'status', 'tenantId', 'createdBy', 'createdAt', 'updatedAt']) &&
             data.title is string && data.title.size() <= 200 &&
             data.tag is string && data.tag.size() <= 100 &&
             data.status is string && data.status.size() <= 50 &&
             data.tenantId is string && data.tenantId.size() <= 128 &&
             data.createdBy is string && data.createdBy.size() <= 128 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // For list, we force the query to filter by tenantId, but users can only read their tenant's users
      allow list: if isSignedIn() && resource.data.tenantId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId;
      
      // On create, user must match their own UID, and they CANNOT set isApproved=true or roles=['admin'] initially.
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId &&
                       isValidUser(incoming()) && 
                       incoming().isApproved == false &&
                       !('admin' in incoming().roles) &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;

      allow update: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'birthdate', 'updatedAt']) &&
          incoming().updatedAt == request.time
        )
      );
    }

    match /tasks/{taskId} {
      allow get, list: if isSignedIn() && resource.data.tenantId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId;

      allow create: if isSignedIn() && isValidId(taskId) && isValidTask(incoming()) &&
                       incoming().tenantId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId &&
                       incoming().createdBy == request.auth.uid &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;

      allow update: if isSignedIn() && isValidId(taskId) && isValidTask(incoming()) && (
        isAdmin() ||
        (
          existing().tenantId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId &&
          incoming().tenantId == existing().tenantId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'tag', 'title', 'assigneeId', 'updatedAt']) &&
          incoming().updatedAt == request.time
        )
      );

      allow delete: if isAdmin();
    }
  }
}
